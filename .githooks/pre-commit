#!/usr/bin/env sh
set -eu

if command -v py >/dev/null 2>&1; then
    PYTHON="py -3"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON="python3"
else
    PYTHON="python"
fi

timeout 120s $PYTHON -m compileall -q src api build.py main.py sync_chglog.py
timeout 120s $PYTHON -m unittest discover -s tests -p 'test_*.py'
